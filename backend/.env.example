# ==================== SERVER ====================
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# ==================== DATABASE ====================
# PostgreSQL (Production)
DATABASE_URL="postgresql://user:password@localhost:5432/avisboost?schema=public"

# SQLite (Développement - décommentez pour utiliser)
# DATABASE_URL="file:./dev.db"

# ==================== JWT ====================
JWT_SECRET=votre_secret_jwt_super_securise_changez_moi
JWT_EXPIRES_IN=24h

# ==================== STRIPE ====================
STRIPE_SECRET_KEY=sk_test_votre_cle_stripe
STRIPE_PUBLISHABLE_KEY=pk_test_votre_cle_publique_stripe
STRIPE_WEBHOOK_SECRET=whsec_votre_webhook_secret

# ==================== EMAIL ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre.email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_app
EMAIL_FROM=AvisBoost <noreply@avisboost.com>

# ==================== FRONTEND ====================
FRONTEND_URL=http://localhost:8080

# ==================== DISCORD ====================
DISCORD_BOT_TOKEN=votre_token_discord
DISCORD_CLIENT_ID=votre_client_id

# ==================== AUTRES ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Prices (en EUR)
PRICE_STARTER=89
PRICE_PRO=159
PRICE_BUSINESS=329
